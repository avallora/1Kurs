#define _USE_MATH_DEFINES
#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <locale.h>

int main() {
	setlocale(LC_CTYPE, "RUS");

	double gr;
	printf("Введите угол в градусах: ");
	scanf("%lf", &gr);

	printf("sin(%.0f) = %.6f\n", gr, sin(gr * M_PI / 180));

	system("pause");
	return 0;
}	
